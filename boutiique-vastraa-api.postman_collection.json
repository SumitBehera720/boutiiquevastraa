{
  "info": {
    "_postman_id": "boutiique-vastraa-api-collection",
    "name": "Boutiique Vastraa – All APIs",
    "description": "Complete API collection for Boutiique Vastraa deployed on Hostinger.\n\nBase URL: https://api.boutiiquevastraa.com\n\nAuthentication:\n- Customer endpoints: use `Authorization: Bearer <token>` (token returned from login/register)\n- Admin endpoints: use `Authorization: Bearer admin-token`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.boutiiquevastraa.com", "type": "string" },
    { "key": "customerToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "admin-token", "type": "string" },
    { "key": "cartId", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "collectionHandle", "value": "all", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "couponId", "value": "", "type": "string" },
    { "key": "reviewId", "value": "", "type": "string" },
    { "key": "lineId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\"\n}" },
            "description": "Register a new customer account. Returns token + user."
          }
        },
        {
          "name": "Login (Customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\"\n}" },
            "description": "Login as customer. Copy the returned token into customerToken variable."
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin\",\n  \"password\": \"your-admin-password\"\n}" },
            "description": "Login as admin. Returns 'admin-token'."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","auth","logout"] },
            "description": "Invalidate the current session token."
          }
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api","auth","me"] },
            "description": "Get authenticated user profile + order history."
          }
        },
        {
          "name": "Update Address",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auth/me/address", "host": ["{{baseUrl}}"], "path": ["api","auth","me","address"] },
            "body": { "mode": "raw", "raw": "{\n  \"address1\": \"123 Main Street\",\n  \"address2\": \"\",\n  \"city\": \"Mumbai\",\n  \"province\": \"Maharashtra\",\n  \"zip\": \"400001\",\n  \"country\": \"India\",\n  \"phone\": \"+91 9999999999\"\n}" },
            "description": "Update authenticated user's default address."
          }
        },
        {
          "name": "Update Wishlist",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auth/me/wishlist", "host": ["{{baseUrl}}"], "path": ["api","auth","me","wishlist"] },
            "body": { "mode": "raw", "raw": "{\n  \"wishlist\": [\n    { \"id\": \"product-id-1\", \"title\": \"Product Name\", \"handle\": \"product-handle\" }\n  ]\n}" },
            "description": "Replace the authenticated user's wishlist."
          }
        },
        {
          "name": "Sync Cart + Wishlist (Post-Login Merge)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auth/me/sync", "host": ["{{baseUrl}}"], "path": ["api","auth","me","sync"] },
            "body": { "mode": "raw", "raw": "{\n  \"cartId\": \"{{cartId}}\",\n  \"wishlist\": [\n    { \"id\": \"product-id-1\", \"title\": \"Product Name\" }\n  ]\n}" },
            "description": "Merge guest cart + wishlist with user account after login."
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List All Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?per_page=50",
              "host": ["{{baseUrl}}"],
              "path": ["api","products"],
              "query": [{ "key": "per_page", "value": "50" }]
            },
            "description": "Returns all products (max per_page, default 50)."
          }
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/search?q=saree",
              "host": ["{{baseUrl}}"],
              "path": ["api","products","search"],
              "query": [{ "key": "q", "value": "saree" }]
            },
            "description": "Search products by title (case-insensitive partial match)."
          }
        },
        {
          "name": "Get Product by ID or Handle",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api","products","{{productId}}"] },
            "description": "Fetch a single product by ID or handle slug."
          }
        },
        {
          "name": "Get Product Recommendations",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}/recommendations", "host": ["{{baseUrl}}"], "path": ["api","products","{{productId}}","recommendations"] },
            "description": "Returns up to 8 related products (excludes the requested product)."
          }
        }
      ]
    },
    {
      "name": "Collections",
      "item": [
        {
          "name": "List All Collections",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/collections?first=20",
              "host": ["{{baseUrl}}"],
              "path": ["api","collections"],
              "query": [{ "key": "first", "value": "20" }]
            },
            "description": "Returns all collections."
          }
        },
        {
          "name": "Get Collection with Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/collections/{{collectionHandle}}?first=24",
              "host": ["{{baseUrl}}"],
              "path": ["api","collections","{{collectionHandle}}"],
              "query": [{ "key": "first", "value": "24" }]
            },
            "description": "Get a collection by handle with its products. Use 'all' to get all products."
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Create Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/cart", "host": ["{{baseUrl}}"], "path": ["api","cart"] },
            "body": { "mode": "raw", "raw": "{\n  \"lines\": [\n    { \"merchandiseId\": \"variant-id-or-product-id\", \"quantity\": 1 }\n  ]\n}" },
            "description": "Create a new cart. Returns cart with subtotal and checkout URL."
          }
        },
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/cart/{{cartId}}", "host": ["{{baseUrl}}"], "path": ["api","cart","{{cartId}}"] },
            "description": "Retrieve cart by ID."
          }
        },
        {
          "name": "Add Lines to Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/cart/{{cartId}}/lines", "host": ["{{baseUrl}}"], "path": ["api","cart","{{cartId}}","lines"] },
            "body": { "mode": "raw", "raw": "{\n  \"lines\": [\n    { \"merchandiseId\": \"variant-id\", \"quantity\": 2 }\n  ]\n}" },
            "description": "Add items to an existing cart."
          }
        },
        {
          "name": "Update Cart Lines",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/cart/{{cartId}}/lines", "host": ["{{baseUrl}}"], "path": ["api","cart","{{cartId}}","lines"] },
            "body": { "mode": "raw", "raw": "{\n  \"lines\": [\n    { \"id\": \"{{lineId}}\", \"quantity\": 3, \"isGift\": false }\n  ]\n}" },
            "description": "Update quantity or isGift flag for existing cart lines."
          }
        },
        {
          "name": "Delete Lines from Cart",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/cart/{{cartId}}/lines?lineIds=[\"{{lineId}}\"]",
              "host": ["{{baseUrl}}"],
              "path": ["api","cart","{{cartId}}","lines"],
              "query": [{ "key": "lineIds", "value": "[\"{{lineId}}\"]" }]
            },
            "description": "Remove cart lines by their IDs (pass as JSON array in query param)."
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api","orders"] },
            "body": { "mode": "raw", "raw": "{\n  \"cart_id\": \"{{cartId}}\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+91 9999999999\",\n  \"paymentMethod\": \"COD\",\n  \"discount\": 0,\n  \"shippingAddress\": {\n    \"address1\": \"123 Main Street\",\n    \"address2\": \"\",\n    \"city\": \"Mumbai\",\n    \"province\": \"Maharashtra\",\n    \"zip\": \"400001\",\n    \"country\": \"India\"\n  }\n}" },
            "description": "Convert a cart into an order. Returns orderId and orderNumber."
          }
        },
        {
          "name": "Track Order",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/orders/track?order_number=1234&email=john.doe@example.com",
              "host": ["{{baseUrl}}"],
              "path": ["api","orders","track"],
              "query": [
                { "key": "order_number", "value": "1234" },
                { "key": "email", "value": "john.doe@example.com" }
              ]
            },
            "description": "Track order by order number + email."
          }
        }
      ]
    },
    {
      "name": "Coupons",
      "item": [
        {
          "name": "Validate Coupon",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/coupons/validate", "host": ["{{baseUrl}}"], "path": ["api","coupons","validate"] },
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"SAVE10\",\n  \"cart_subtotal\": \"1500.00\"\n}" },
            "description": "Validate a coupon code and get the discount amount for the given subtotal."
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "List All Reviews",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/reviews", "host": ["{{baseUrl}}"], "path": ["api","reviews"] },
            "description": "Get all reviews (including unapproved)."
          }
        },
        {
          "name": "List Approved Reviews (Global / Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/reviews/global", "host": ["{{baseUrl}}"], "path": ["api","reviews","global"] },
            "description": "Get only approved reviews shown publicly on the storefront."
          }
        },
        {
          "name": "Submit Review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/reviews", "host": ["{{baseUrl}}"], "path": ["api","reviews"] },
            "body": { "mode": "raw", "raw": "{\n  \"productId\": \"product-handle-or-id\",\n  \"author\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"rating\": 5,\n  \"comment\": \"Beautiful saree!\"\n}" },
            "description": "Submit a new product review (pending approval)."
          }
        }
      ]
    },
    {
      "name": "Q&A",
      "item": [
        {
          "name": "List All Q&A",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/qna", "host": ["{{baseUrl}}"], "path": ["api","qna"] },
            "description": "Get all product Q&A entries."
          }
        },
        {
          "name": "Submit Question",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/qna", "host": ["{{baseUrl}}"], "path": ["api","qna"] },
            "body": { "mode": "raw", "raw": "{\n  \"productHandle\": \"banarasi-silk-saree\",\n  \"author\": \"Priya Sharma\",\n  \"email\": \"priya@example.com\",\n  \"question\": \"Is this saree dry-clean only?\"\n}" },
            "description": "Submit a new product question (pending admin answer)."
          }
        }
      ]
    },
    {
      "name": "Settings",
      "item": [
        {
          "name": "Get Site Settings",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/settings", "host": ["{{baseUrl}}"], "path": ["api","settings"] },
            "description": "Public site settings: SEO, banners, homepage, footer, header config."
          }
        }
      ]
    },
    {
      "name": "Upload",
      "item": [
        {
          "name": "Upload Image",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/upload", "host": ["{{baseUrl}}"], "path": ["api","upload"] },
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "description": "Image file to upload" }]
            },
            "description": "Upload an image. Returns { success, url: '/images/uploads/filename' }."
          }
        }
      ]
    },
    {
      "name": "Admin",
      "description": "All admin routes require: Authorization: Bearer admin-token",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/dashboard", "host": ["{{baseUrl}}"], "path": ["api","admin","dashboard"] },
            "description": "Summary: total products, collections, orders, customers, revenue."
          }
        },
        {
          "name": "Products – List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/products", "host": ["{{baseUrl}}"], "path": ["api","admin","products"] }
          }
        },
        {
          "name": "Products – Create",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/products", "host": ["{{baseUrl}}"], "path": ["api","admin","products"] },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"New Silk Saree\",\n  \"handle\": \"new-silk-saree\",\n  \"description\": \"<p>Elegant handcrafted saree.</p>\",\n  \"priceRange\": { \"minVariantPrice\": { \"amount\": \"2499.00\", \"currencyCode\": \"INR\" } },\n  \"images\": { \"edges\": [{ \"node\": { \"url\": \"/images/saree.jpg\", \"altText\": \"Saree\" } }] },\n  \"variants\": { \"edges\": [{ \"node\": { \"id\": \"v1\", \"title\": \"Default\", \"price\": { \"amount\": \"2499.00\" }, \"availableForSale\": true } }] },\n  \"collectionHandles\": [\"sarees\"],\n  \"availableForSale\": true\n}" },
            "description": "Create a new product."
          }
        },
        {
          "name": "Products – Update",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/products", "host": ["{{baseUrl}}"], "path": ["api","admin","products"] },
            "body": { "mode": "raw", "raw": "{\n  \"id\": \"{{productId}}\",\n  \"title\": \"Updated Product Title\",\n  \"availableForSale\": true\n}" },
            "description": "Update a product. Include 'id' in body."
          }
        },
        {
          "name": "Products – Delete",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api","admin","products","{{productId}}"] },
            "description": "Delete product by ID."
          }
        },
        {
          "name": "Collections – List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/collections", "host": ["{{baseUrl}}"], "path": ["api","admin","collections"] }
          }
        },
        {
          "name": "Collections – Create",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/collections", "host": ["{{baseUrl}}"], "path": ["api","admin","collections"] },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Lehengas\",\n  \"handle\": \"lehengas\",\n  \"description\": \"Beautiful bridal lehengas.\",\n  \"image\": { \"url\": \"/images/lehenga.jpg\", \"altText\": \"Lehenga\" }\n}" }
          }
        },
        {
          "name": "Collections – Update",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/collections", "host": ["{{baseUrl}}"], "path": ["api","admin","collections"] },
            "body": { "mode": "raw", "raw": "{\n  \"id\": \"collection-id\",\n  \"title\": \"Updated Title\"\n}" }
          }
        },
        {
          "name": "Collections – Delete",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/collections/{{collectionHandle}}", "host": ["{{baseUrl}}"], "path": ["api","admin","collections","{{collectionHandle}}"] }
          }
        },
        {
          "name": "Orders – List All",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/orders", "host": ["{{baseUrl}}"], "path": ["api","admin","orders"] }
          }
        },
        {
          "name": "Orders – Update Fulfillment Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/orders", "host": ["{{baseUrl}}"], "path": ["api","admin","orders"] },
            "body": { "mode": "raw", "raw": "{\n  \"id\": \"{{orderId}}\",\n  \"fulfillmentStatus\": \"FULFILLED\"\n}" },
            "description": "Update order status. Values: UNFULFILLED, FULFILLED, SHIPPED."
          }
        },
        {
          "name": "Customers – List All",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/customers", "host": ["{{baseUrl}}"], "path": ["api","admin","customers"] }
          }
        },
        {
          "name": "Coupons – List All",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/coupons", "host": ["{{baseUrl}}"], "path": ["api","admin","coupons"] }
          }
        },
        {
          "name": "Coupons – Create / Update",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/coupons", "host": ["{{baseUrl}}"], "path": ["api","admin","coupons"] },
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"SAVE10\",\n  \"type\": \"percentage\",\n  \"value\": \"10\",\n  \"active\": true\n}" },
            "description": "Create new coupon. Include 'id' to update. type: 'percentage' or 'fixed'."
          }
        },
        {
          "name": "Coupons – Toggle Active/Inactive",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/coupons/toggle/{{couponId}}", "host": ["{{baseUrl}}"], "path": ["api","admin","coupons","toggle","{{couponId}}"] }
          }
        },
        {
          "name": "Coupons – Delete",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/coupons/{{couponId}}", "host": ["{{baseUrl}}"], "path": ["api","admin","coupons","{{couponId}}"] }
          }
        },
        {
          "name": "Reviews – List All",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/reviews", "host": ["{{baseUrl}}"], "path": ["api","admin","reviews"] }
          }
        },
        {
